pipeline {
    agent none
    options {
        timeout(time: 30, unit: 'SECONDS')
    }
    stages {
        stage('input') {
            agent any
            input {
                message "What is your first commit?"
                ok "Submit"
                parameters {
                    string(defaultValue: 'Dave', name: 'FIRST_NAME', trim: true)
                }
            }
            options {
                timeout(time: 10, unit: 'SECONDS' )
            }
            steps {
                echo "Good morning, $FIRST_NAME"
                sh '''
                    hostname
                    cat /etc/redhat-release
                ''' 
            }
        }
    }
}